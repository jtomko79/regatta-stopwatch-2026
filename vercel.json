{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/live",
      "destination": "/api/live-handler"
    },
    {
      "source": "/api/live/(.*)",
      "destination": "/api/live-handler"
    }
  ]
}